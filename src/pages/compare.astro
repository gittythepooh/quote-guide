---
import Base from '../layouts/Base.astro';
import Comparer from '../components/Comparer.svelte';
import Journey from '../components/Journey.astro';
---

<Base title="Choose | Fog Off">
  <Journey current={3} />
  <div class="wrap" style="padding-block:56px 28px;">
    <span class="pill">Step 3 · Choose</span>
    <h1 style="font-size:clamp(2rem,5vw,3rem); letter-spacing:-0.03em; line-height:1.1; margin:16px 0 12px;">
      Choose between your real quotes
    </h1>
    <p style="color:var(--muted); font-size:1.08rem; max-width:62ch; margin:0;">
      Your tests found what to change, on one site. Now apply those changes honestly on a few sites and insurers, enter the quotes you get, and see which is really the best value once the excess is counted.
    </p>
  </div>
  <div class="wrap">
    <Comparer client:only="svelte" />
    <p class="nextstep"><a href="/findings/#share">Next: share what you found →</a></p>
  </div>
</Base>

<style>
  .nextstep { margin: 28px 0 0; text-align: right; }
  .nextstep a { color: var(--accent); font-weight: 700; text-decoration: none; }
</style>
