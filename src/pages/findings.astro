---
import Base from '../layouts/Base.astro';
import Journey from '../components/Journey.astro';
import Findings from '../components/Findings.svelte';
import ShareStep from '../components/ShareStep.svelte';
---

<Base title="Findings | Fog Off" description="What changed car insurance quotes in tests, from a starting point and from community reports.">
  <Journey current={4} />
  <div class="wrap" style="padding-block:28px 24px;">
    <span class="pill">Community findings</span>
    <h1 style="font-size:clamp(2rem,5vw,3rem); letter-spacing:-0.03em; line-height:1.1; margin:16px 0 12px;">
      Share, and see what changes the price
    </h1>
    <p style="color:var(--muted); font-size:1.08rem; max-width:62ch; margin:0 0 8px;">
      We start with figures from one early test. As people share their own results anonymously, community medians replace them. A figure only appears once 20 people have reported the same change.
    </p>
  </div>
  <div class="wrap">
    <ShareStep client:only="svelte" />
    <Findings client:load />
  </div>
</Base>
