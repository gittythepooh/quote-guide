---
import Base from '../layouts/Base.astro';
import WhatIf from '../components/WhatIf.svelte';
---

<Base title="What-if explorer | Quote Guide">
  <div class="wrap" style="padding-block:56px 28px;">
    <span class="pill">Interactive</span>
    <h1 style="font-size:clamp(2rem,5vw,3rem); letter-spacing:-0.03em; line-height:1.1; margin:16px 0 12px;">
      What-if explorer
    </h1>
    <p style="color:var(--muted); font-size:1.08rem; max-width:62ch; margin:0 0 8px;">
      Get a baseline quote on a comparison site. Change one thing at a time and note each price. Enter them here to see which changes really mattered.
    </p>
    <p style="color:var(--muted); font-size:0.92rem; margin:0;">
      Test changes freely, but buy only on true answers. See the <a href="/guide/" style="color:var(--accent); font-weight:600;">guide</a>.
    </p>
  </div>
  <div class="wrap">
    <WhatIf client:only="svelte" />
  </div>
</Base>
