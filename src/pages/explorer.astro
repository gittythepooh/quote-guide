---
import Base from '../layouts/Base.astro';
import Explorer from '../components/Explorer.svelte';
---

<Base title="Your test plan | Quote Guide">
  <div class="wrap" style="padding-block:56px 28px;">
    <span class="pill">Interactive</span>
    <h1 style="font-size:clamp(2rem,5vw,3rem); letter-spacing:-0.03em; line-height:1.1; margin:16px 0 12px;">
      Your test plan
    </h1>
    <p style="color:var(--muted); font-size:1.08rem; max-width:62ch; margin:0 0 8px;">
      Get a baseline price, then work down the tests one at a time. Each card says what to change on the comparison site. Enter the price and see straight away whether it really mattered.
    </p>
    <p style="color:var(--muted); font-size:0.92rem; margin:0;">
      Test freely, but buy only on true answers. See the <a href="/guide/" style="color:var(--accent); font-weight:600;">guide</a>.
    </p>
  </div>
  <div class="wrap">
    <Explorer client:only="svelte" />
  </div>
</Base>
