---
// Landing scroll story: a calm, type-led intro. Fog covers the page and lifts as you scroll;
// the first question of the guided check is revealed underneath.
// Without JavaScript, or with reduced motion, it is a static stack of the same text.
---

<section class="scene" data-scene data-phase="hero" aria-labelledby="fs-h1">
  <div class="stage">
    <div class="fog" aria-hidden="true">
      <img class="cl k1" src="/art/cloud.webp" alt="" width="1400" height="369" />
      <img class="cl k2 flip" src="/art/cloud.webp" alt="" width="1400" height="369" />
      <img class="cl k3" src="/art/cloud.webp" alt="" width="1400" height="369" />
      <img class="cl k4 flip" src="/art/cloud.webp" alt="" width="1400" height="369" />
      <img class="cl k5" src="/art/cloud.webp" alt="" width="1400" height="369" />
      <img class="cl k6 flip" src="/art/cloud.webp" alt="" width="1400" height="369" />
      <img class="cl k7" src="/art/cloud.webp" alt="" width="1400" height="369" />
    </div>

    <div class="beats">
      <div class="beat b0">
        <p class="eyebrow">Fog Off</p>
        <h1 id="fs-h1">See through the fog on car insurance prices.</h1>
        <p class="sub">Quotes change for reasons nobody explains. Fog Off shows you which honest changes really move yours.</p>
        <div class="acts">
          <button type="button" class="go" data-skip>Get started</button>
          <span class="cue">or scroll</span>
        </div>
      </div>

      <div class="beat b1">
        <h2>Same car. Same you. Different prices.</h2>
        <p>Your job title. An extra driver. Even the day you ask. Insurers rarely say why a price moves.</p>
      </div>

      <div class="beat b2">
        <h2>So we went looking for answers.</h2>
        <p>Fog Off turns your own test quotes into clear numbers, then lets you share what worked, anonymously.</p>
      </div>

      <div class="beat b3">
        <h2>Free. Independent. Yours.</h2>
        <p>No adverts, no sign-up, no commission. Your answers stay in your browser unless you choose to share.</p>
      </div>

      <div class="art" aria-hidden="true">
        <div class="road"></div>
        <div class="car-wrap">
          <div class="carbox">
            <img class="carimg" src="/art/car.webp" alt="" width="1400" height="556" />
            <img class="rim r1" src="/art/rim.webp" alt="" width="164" height="164" />
            <img class="rim r2" src="/art/rim.webp" alt="" width="164" height="164" />
            <div class="win"><img class="drv seated" src="/art/seated.webp" alt="" width="600" height="612" /></div>
          </div>
        </div>
        <div class="faller"><img src="/art/fall.webp" alt="" width="600" height="467" /></div>
      </div>

      <div class="start" data-start>
        <p class="eyebrow">Fog cleared</p>
        <h2 class="q">Let us find what is worth testing on your quote.</h2>
        <p class="lede">Eleven quick questions, about two minutes. Nothing leaves your browser.</p>
        <p class="acts"><a class="go" href="/start/" data-begin>Start the check</a></p>
        <p class="alt"><a href="/explorer/">Already started? Open the test plan</a></p>
      </div>
    </div>

    <button type="button" class="skipbtn" data-skip aria-label="Skip intro">Skip intro</button>
    <div class="rail" aria-hidden="true"><b></b></div>
  </div>
</section>

<style>
  .scene {
    --c1: #f1f5f8; --c2: #d3dee7; --sky: #ffffff;
    --p: 0; --clear: 0; --b0: 1; --b1: 0; --b2: 0; --b3: 0; --st: 0; --fall: 0; --fallv: 0; --seat: 0; --land: 0; --drive: 0; --roadv: 0;
    --car-w: clamp(280px, 44vw, 480px);
    background: var(--sky);
    color: var(--text);
  }
  /* The art is drawn for a white page, so the intro stays light in dark mode too. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .scene { --bg: #f7f8f6; --surface: #fff; --text: #14201b; --muted: #5b6a63; --line: #e1e6e1; --accent: #0f766e; --accent-text: #fff; }
  }
  :root[data-theme='dark'] .scene { --bg: #f7f8f6; --surface: #fff; --text: #14201b; --muted: #5b6a63; --line: #e1e6e1; --accent: #0f766e; --accent-text: #fff; }

  .stage { position: relative; overflow: hidden; min-height: calc(100dvh - 64px); display: grid; place-items: center; padding: 56px 24px; }
  .fog { position: absolute; inset: 0; pointer-events: none; }
  .cl { position: absolute; display: block; }
  .k1 { width: 62vw; left: -12vw; top: 4%; }
  .k2 { width: 54vw; right: -10vw; top: 14%; }
  .k3 { width: 70vw; left: 14vw; top: 30%; }
  .k4 { width: 58vw; left: -16vw; top: 52%; }
  .k5 { width: 64vw; right: -14vw; top: 58%; }
  .k6 { width: 48vw; left: 30vw; top: -6%; }
  .k7 { width: 80vw; left: 6vw; top: 72%; }

  .beats { position: relative; width: min(760px, 100%); }
  .beat { text-align: center; }
  .beat + .beat { margin-top: 72px; }
  .eyebrow { margin: 0 0 14px; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  h1, h2 { margin: 0; font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; text-wrap: balance; }
  h1 { font-size: clamp(2.3rem, 6.4vw, 4.4rem); }
  h2 { font-size: clamp(2rem, 5vw, 3.4rem); }
  .beat p:not(.eyebrow) { margin: 20px auto 0; max-width: 46ch; color: var(--muted); font-size: clamp(1rem, 1.7vw, 1.15rem); line-height: 1.55; }
  .acts { margin-top: 30px; display: flex; gap: 16px; align-items: center; justify-content: center; }
  .go { font: inherit; font-weight: 600; color: var(--accent-text); background: var(--accent); border: 0; border-radius: 999px; padding: 14px 28px; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
  .go:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(15, 118, 110, 0.28); }
  .cue { color: var(--muted); font-size: 0.9rem; }

  .start { margin-top: 72px; text-align: center; }
  .start .q { font-size: clamp(1.8rem, 4.4vw, 2.8rem); }
  .start .lede { margin: 16px auto 0; max-width: 44ch; color: var(--muted); font-size: clamp(1rem, 1.7vw, 1.15rem); }
  a.go { display: inline-block; text-decoration: none; }
  .start .acts { margin-top: 28px; }
  .alt { margin: 26px 0 0; font-size: 0.92rem; color: var(--muted); }
  .alt a { color: var(--accent); font-weight: 600; }

  /* ---- car and character ---- */
  .art { position: relative; height: 160px; margin: 56px auto 0; width: min(420px, 100%); }
  .road { position: absolute; left: -40vw; right: -40vw; bottom: 6px; height: 1px; background: var(--line); }
  .car-wrap { position: absolute; left: 50%; bottom: 6px; width: var(--car-w); transform: translateX(-50%); }
  .carbox { position: relative; }
  .carimg { display: block; width: 100%; height: auto; }
  .rim { position: absolute; width: 11.5%; top: 78.5%; transform: translate(-50%, -50%); border-radius: 50%; }
  .r1 { left: 17.7%; } .r2 { left: 81.8%; }
  .win { position: absolute; inset: 0; clip-path: polygon(44% 31%, 43.3% 6.2%, 56.8% 6.2%, 65.9% 30%); }
  .drv { position: absolute; width: 24.5%; left: 47.3%; top: 7.6%; clip-path: none; }
  .cl { height: auto; }
  .flip { scale: -1 1; }
  .faller { display: none; }

  .skipbtn, .rail { display: none; }

  /* ---- live (scroll-driven) ---- */
  .scene.live { height: 480dvh; }
  .live .stage { position: sticky; top: var(--hdr, 64px); height: calc(100dvh - var(--hdr, 64px)); min-height: 0; }
  .live .beats { position: absolute; inset: 0; width: auto; display: grid; place-items: center; padding: 0 24px; }
  .live .beat, .live .start { grid-area: 1 / 1; margin: 0; width: min(760px, 100%); will-change: opacity, transform; }
  .live .b1, .live .b2, .live .b3 { align-self: start; margin-top: 11dvh; }
  .live .b0 { opacity: var(--b0); transform: translate3d(0, calc((1 - var(--b0)) * -24px), 0); pointer-events: none; }
  .live .b1 { opacity: var(--b1); transform: translate3d(0, calc((1 - var(--b1)) * 24px), 0); }
  .live .b2 { opacity: var(--b2); transform: translate3d(0, calc((1 - var(--b2)) * 24px), 0); }
  .live .b3 { opacity: var(--b3); transform: translate3d(0, calc((1 - var(--b3)) * 24px), 0); }
  .live .start { opacity: var(--st); transform: translate3d(0, calc((1 - var(--st)) * 28px), 0); visibility: hidden; }
  .live[data-phase='hero'] .b0 { pointer-events: auto; }
  .live:not([data-phase='hero']) .b0 { visibility: hidden; }
  /* A soft clearing behind the words keeps them readable over the fog. */
  .live .beat { position: relative; isolation: isolate; }
  .live .beat::before { content: ''; position: absolute; inset: -40px -60px; z-index: -1; background: radial-gradient(closest-side, rgba(255,255,255,0.92), rgba(255,255,255,0.75) 55%, rgba(255,255,255,0)); border-radius: 50%; }
  .live[data-phase='start'] .start { visibility: visible; }

  .live .cl { will-change: transform, opacity; opacity: calc(0.96 - var(--clear) * 0.96); }
  .live .k1 { transform: translate3d(calc(var(--clear) * -70vw), calc(var(--clear) * -12dvh), 0); }
  .live .k2 { transform: translate3d(calc(var(--clear) * 70vw), calc(var(--clear) * -10dvh), 0); }
  .live .k3 { transform: translate3d(calc(var(--clear) * -60vw), calc(var(--clear) * -26dvh), 0); }
  .live .k4 { transform: translate3d(calc(var(--clear) * -70vw), calc(var(--clear) * 10dvh), 0); }
  .live .k5 { transform: translate3d(calc(var(--clear) * 70vw), calc(var(--clear) * 14dvh), 0); }
  .live .k6 { transform: translate3d(calc(var(--clear) * 50vw), calc(var(--clear) * -30dvh), 0); }
  .live .k7 { transform: translate3d(calc(var(--clear) * 60vw), calc(var(--clear) * 24dvh), 0); }

  .live .art { position: absolute; inset: 0; height: auto; margin: 0; width: auto; pointer-events: none; --road: 15dvh; }
  .live .road { bottom: var(--road); opacity: var(--roadv); }
  .live .car-wrap { bottom: var(--road); opacity: var(--roadv);
    transform: translate3d(calc(-50% + var(--drive) * var(--drive) * (62vw + var(--car-w))), calc(var(--land) * 5px), 0); }
  .live .rim { transform: translate(-50%, -50%) rotate(calc(var(--drive) * 1900deg)); }
  .live .seated { opacity: var(--seat); }
  .live .faller { display: block; position: absolute; left: 50%; width: clamp(120px, 17vw, 190px); bottom: calc(var(--road) + var(--car-w) * 0.3);
    opacity: calc((1 - var(--seat)) * var(--fallv));
    transform: translate3d(-50%, calc((var(--fall) * var(--fall) - 1) * 76dvh), 0) rotate(calc(sin(calc(var(--p) * 60)) * 8deg)); }
  .faller img { display: block; width: 100%; height: auto; }

  .live .skipbtn { display: block; position: absolute; top: 16px; right: 20px; font: inherit; font-size: 0.85rem; font-weight: 600; color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; cursor: pointer; transition: color 0.2s, border-color 0.2s, opacity 0.3s; }
  .live .skipbtn:hover { color: var(--accent); border-color: var(--accent); }
  .live[data-phase='start'] .skipbtn { opacity: 0; visibility: hidden; pointer-events: none; }
  .live .rail { display: block; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--line); }
  .live .rail b { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(var(--p)); }

  @media (max-width: 720px) {
    .stage { padding: 40px 18px; }
    .live .skipbtn { top: 10px; right: 14px; }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && !reduced) {
    const stage = scene.querySelector<HTMLElement>('.stage')!;
    const header = document.querySelector<HTMLElement>('.site-header');
    scene.classList.add('live');
    let ticking = false;

    // Each beat fades in, holds, fades out. Triangle with a plateau.
    const win = (p: number, a: number, b: number, c: number, d: number) =>
      Math.max(0, Math.min(1, p < b ? (p - a) / (b - a) : p > c ? (d - p) / (d - c) : 1));
    const set = (k: string, v: number) => scene.style.setProperty(k, v.toFixed(4));

    const measure = () => {
      const hdr = header ? header.offsetHeight : 64;
      scene.style.setProperty('--hdr', hdr + 'px');
      return hdr;
    };
    const update = () => {
      ticking = false;
      const hdr = measure();
      const total = scene.offsetHeight - stage.offsetHeight;
      const top = scene.getBoundingClientRect().top;
      const p = Math.min(1, Math.max(0, (hdr - top) / total));
      set('--p', p);
      set('--clear', Math.min(1, Math.max(0, (p - 0.08) / 0.62)));
      set('--b0', 1 - Math.min(1, p / 0.12));
      set('--b1', win(p, 0.1, 0.18, 0.28, 0.36));
      set('--b2', win(p, 0.32, 0.4, 0.5, 0.58));
      set('--b3', win(p, 0.52, 0.58, 0.63, 0.68));
      set('--roadv', win(p, 0.46, 0.56, 0.97, 1.0));
      const f = Math.min(1, Math.max(0, (p - 0.63) / 0.17));
      set('--fall', f);
      set('--fallv', Math.min(1, f * 30));
      set('--seat', f >= 1 ? 1 : 0);
      const l = Math.min(1, Math.max(0, (p - 0.8) / 0.04));
      set('--land', Math.sin(l * Math.PI));
      set('--drive', Math.min(1, Math.max(0, (p - 0.85) / 0.12)));
      set('--st', win(p, 0.9, 0.96, 1.1, 1.2));
      scene.dataset.phase = p < 0.06 ? 'hero' : p < 0.93 ? 'story' : 'start';
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();

    // "Get started": glide down to the first question (speeds up, then eases in).
    let rushing = false;
    ['wheel', 'touchstart', 'keydown'].forEach((ev) => addEventListener(ev, () => { rushing = false; }, { passive: true }));
    const rush = (slow: boolean) => {
      const hdr = measure();
      const total = scene.offsetHeight - stage.offsetHeight;
      const target = scene.getBoundingClientRect().top + scrollY - hdr + total;
      const from = scrollY;
      const dist = target - from;
      const dur = slow ? 5200 : 1800;
      const t0 = performance.now();
      rushing = true;
      const ease = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;
      const step = (now: number) => {
        if (!rushing) return;
        const t = Math.min(1, (now - t0) / dur);
        scrollTo({ top: from + dist * ease(t), behavior: 'instant' });
        if (t < 1) requestAnimationFrame(step);
        else { rushing = false; update(); (document.querySelector('[data-begin]') as HTMLElement | null)?.focus({ preventScroll: true }); }
      };
      requestAnimationFrame(step);
    };
    document.querySelectorAll<HTMLElement>('[data-skip]').forEach((b) => b.addEventListener('click', () => rush(!b.classList.contains('skipbtn'))));
  } else {
    document.querySelectorAll('[data-skip]').forEach((b) => b.addEventListener('click', () => (location.href = '/start/')));
  }

</script>
