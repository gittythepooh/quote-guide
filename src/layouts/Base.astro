---
import '@fontsource-variable/manrope';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Plain-English help to get fair value on car insurance. Information only. Your answers stay in your browser unless you choose to share.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/start/', label: 'Start' },
  { href: '/explorer/', label: 'Test plan' },
  { href: '/findings/', label: 'Findings' },
  { href: '/guide/', label: 'Guide' },
];
const active = (href: string) => path.startsWith(href);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <!-- PRE-LAUNCH: remove this robots tag AND the X-Robots-Tag line in public/_headers at launch. `npm run check:launch` fails while they exist. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-bar">
        <a href="/" class="site-brand">
          <span class="site-logo" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <span>Fog Off</span>
        </a>

        <nav aria-label="Main" class="site-nav">
          {links.map((l) => (
            <a href={l.href} aria-current={active(l.href) ? 'page' : undefined} class:list={['site-nl', { on: active(l.href) }]}>{l.label}</a>
          ))}
        </nav>

        <details class="site-menu">
          <summary aria-label="Menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </summary>
          <nav aria-label="Menu" class="site-sheet">
            {links.map((l) => (
              <a href={l.href} aria-current={active(l.href) ? 'page' : undefined} class:list={['site-ml', { on: active(l.href) }]}>{l.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap" style="display:grid; gap:10px;">
        <p style="margin:0; max-width:70ch;">
          <strong style="color:var(--text);">Information only.</strong> Fog Off is not authorised or regulated by the Financial Conduct Authority. We do not sell, arrange or advise on insurance, and we do not recommend any insurer or policy. Always answer quote questions truthfully: wrong answers can reduce or void a claim payout.
        </p>
        <p style="margin:0; max-width:70ch;">
          <strong style="color:var(--text);">Made with AI.</strong> Fog Off was designed and built with the help of AI tools (including Claude by Anthropic), covering the text, code and artwork. A person reviews it, but mistakes are possible. The numbers on this site come from tests and community reports, not from AI.
        </p>
        <p style="margin:0;">
          Free and independent. Funded by donations. No affiliate links. Your answers stay in your browser unless you choose to share.{' '}
          <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> ·
          <button type="button" id="clear-data" class="linkbtn">Clear my saved data</button>
        </p>
      </div>
    </footer>

    <script>
      // One click to remove everything this site stored on this device.
      document.getElementById('clear-data')?.addEventListener('click', () => {
        if (!confirm('Remove everything Fog Off saved on this device (answers, test plan, quotes)? This cannot be undone.')) return;
        try {
          Object.keys(localStorage).filter((k) => k.startsWith('qg-')).forEach((k) => localStorage.removeItem(k));
        } catch {}
        location.reload();
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-text); padding: 8px 14px; border-radius: 10px; z-index: 50; font-weight: 700; }
  .skip-link:focus { left: 12px; }
  .site-header { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); position: sticky; top: 0; z-index: 20; backdrop-filter: blur(10px); }
  .site-bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 12px; }
  .site-brand { display: flex; align-items: center; gap: 10px; white-space: nowrap; font-weight: 800; color: var(--text); text-decoration: none; letter-spacing: -0.01em; }
  .site-logo { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--accent); color: var(--accent-text); }
  .site-nav { display: flex; gap: 4px; }
  .site-nl, .site-ml { padding: 8px 14px; white-space: nowrap; border-radius: 999px; font-weight: 600; font-size: 0.92rem; text-decoration: none; color: var(--muted); }
  .site-nl:hover, .site-ml:hover { color: var(--text); background: var(--surface-2); }
  .site-nl.on, .site-ml.on { color: var(--accent); background: var(--accent-soft); }
  .site-menu { display: none; position: relative; }
  .site-menu summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; color: var(--text); border: 1px solid var(--line); }
  .site-menu summary::-webkit-details-marker { display: none; }
  .site-menu[open] summary { background: var(--surface-2); }
  .site-sheet { position: absolute; right: 0; top: 50px; min-width: 200px; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); padding: 8px; display: grid; gap: 2px; }
  .site-ml { font-size: 1rem; padding: 12px 14px; border-radius: 12px; }
  @media (max-width: 720px) { .site-nav { display: none; } .site-menu { display: block; } }
  .site-foot { border-top: 1px solid var(--line); margin-top: 72px; padding: 32px 0 48px; color: var(--muted); font-size: 0.88rem; }
  .site-foot a, .linkbtn { color: var(--accent); font-weight: 600; text-decoration: none; }
  .site-foot a:hover, .linkbtn:hover { text-decoration: underline; }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; font-weight: 600; cursor: pointer; }
</style>
