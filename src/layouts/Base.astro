---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Plain-English help to get fair value on car insurance. Information only. Your answers stay in your browser.' } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/start/', label: 'Start' },
  { href: '/guide/', label: 'Guide' },
  { href: '/explorer/', label: 'Test plan' },
  { href: '/compare/', label: 'Compare' },
  { href: '/findings/', label: 'Findings' },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <!-- PRE-LAUNCH: remove this robots tag AND the X-Robots-Tag line in public/_headers at launch. `npm run check:launch` fails while they exist. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header style="border-bottom:1px solid var(--line); background:var(--bg); position:sticky; top:0; z-index:10; backdrop-filter:blur(8px);">
      <div class="wrap" style="display:flex; align-items:center; justify-content:space-between; height:64px;">
        <a href="/" style="display:flex; align-items:center; gap:10px; white-space:nowrap; font-weight:800; color:var(--text); text-decoration:none; letter-spacing:-0.01em;">
          <span style="display:grid; place-items:center; width:30px; height:30px; border-radius:9px; background:var(--accent); color:var(--accent-text);" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <span class="brand-text">Quote Guide</span>
        </a>
        <nav aria-label="Main" class="mainnav" style="display:flex; gap:4px; min-width:0; overflow-x:auto;">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={path.startsWith(l.href) ? 'page' : undefined}
              style={`padding:8px 12px; white-space:nowrap; border-radius:999px; font-weight:600; font-size:0.92rem; text-decoration:none; color:${path.startsWith(l.href) ? 'var(--accent)' : 'var(--muted)'}; background:${path.startsWith(l.href) ? 'var(--accent-soft)' : 'transparent'};`}
            >{l.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer style="border-top:1px solid var(--line); margin-top:72px; padding:32px 0 48px; color:var(--muted); font-size:0.88rem;">
      <div class="wrap" style="display:grid; gap:10px;">
        <p style="margin:0; max-width:70ch;">
          <strong style="color:var(--text);">Information only.</strong> Quote Guide is not authorised or regulated by the Financial Conduct Authority. We do not sell, arrange or advise on insurance, and we do not recommend any insurer or policy. Always answer quote questions truthfully: wrong answers can reduce or void a claim payout.
        </p>
        <p style="margin:0;">Free and independent. Funded by donations. No affiliate links. Your answers stay in your browser unless you choose to share. <a href="/privacy/" style="color:var(--accent);">Privacy</a> · <a href="/terms/" style="color:var(--accent);">Terms</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .mainnav { scrollbar-width: none; }
  .mainnav::-webkit-scrollbar { display: none; }
  @media (max-width: 560px) {
    .brand-text { display: none; }
    .mainnav a { padding: 8px 10px !important; font-size: 0.88rem !important; }
  }
</style>
